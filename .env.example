# Copy to .env. Every variable here is read by app/config.py — nothing else is.

# ── Terac ── from the attendee doc at the 09:15 opening ceremony
TERAC_API_KEY=
TERAC_BASE_URL=https://terac.com/api/external/v2
# Generated by Terac when the webhook subscription is created — you cannot choose it, and the
# dashboard's "Add webhook" dialog does not show it. Get it with:
#   make probe SVC=terac_webhook ARGS="--target https://<public-host>/hooks/terac"
# which registers, confirms, reads the secret back, and prints the line to paste here. Leaving it
# empty means /hooks/terac accepts deliveries UNVERIFIED (loud log, polling still works).
TERAC_WEBHOOK_SECRET=
# Optional: reuse an existing project instead of creating one per run.
TERAC_PROJECT_ID=

# ── Band ── app.band.ai/agents. Keys shown ONCE. Credentials live in agent_config.yaml
# (gitignored), not here: each agent needs its own agent_id + api_key and there is no shared
# key. See agent_config.yaml.example.

# ── Superserve ── superserve.ai console. Key format ss_live_…
SUPERSERVE_API_KEY=

# ── Whop ── dashboard > Settings.
# WHOP_PLAN_ID is optional: with it we check out against that existing plan, without it Whop
# creates an inline one-time plan at SCAN_PRICE_USD. `plan_id` and `plan` are mutually exclusive
# in Whop's schema, so app/clients/whop.py sends exactly one.
# WHOP_WEBHOOK_SECRET enables Standard Webhooks verification on /hooks/whop. Unset means every
# caller can claim a payment succeeded, so set it before taking real money.
WHOP_API_KEY=
# The biz_… id. It is in your dashboard URL — whop.com/dashboard/<biz_…>/ — and is also the `id`
# returned by GET https://api.whop.com/api/v1/accounts/me.
WHOP_COMPANY_ID=
WHOP_PLAN_ID=
WHOP_WEBHOOK_SECRET=

# ── Replay QA ── Settings > API Token. Key starts with lqa_.
# Verified: a live REST API at https://qa.replay.io/api/v1 (openapi.json fetched 2026-08-14).
# REPLAY_BASE_URL is optional and defaults to that host — override only for a staging server.
# With BUG_SOURCE=replay, only REPLAY_API_KEY is required.
REPLAY_API_KEY=
REPLAY_BASE_URL=

# ── LLM ── the Band agents need OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OVERWATCH_LLM_MODEL=gpt-5.5
OVERWATCH_LLM_FALLBACK_MODEL=gpt-4o

# ── App ──
# Defaults to sqlite:///./overwatch.db locally. Use Render Postgres in deployment.
DATABASE_URL=
# Must be a public https origin before either Terac round launches: participants load the
# evidence screenshots from their own phones, and launch_round1 refuses if it is not.
PUBLIC_BASE_URL=http://localhost:8000
EVIDENCE_BASE_URL=
# Must be persistent storage on Render. Ephemeral disk wipes on redeploy and both rounds break.
EVIDENCE_DIR=./evidence
SCAN_PRICE_USD=49

# Shared secret for the operator API — the endpoints that launch Terac rounds and so spend real
# money (/api/scans/{id}/round1, /round2, /v2, /poll, /api/terac/balance).
#
# Required as soon as PUBLIC_BASE_URL is a public host: those endpoints return 503 until it is
# set, because an open endpoint that hires twelve people is a loop over our balance. On localhost
# it is optional, so `make rehearse` and the demo need no extra setup.
#
# Generate one with:  python -c "import secrets; print('op_' + secrets.token_urlsafe(32))"
OPERATOR_TOKEN=

# ── Bug source ── playwright | replay | seed
# `seed` replays app/sources/seed_findings.json. It is the 12:30 gate fallback, and the report
# labels itself as a recorded fallback when used, so it can never pass as a live scan.
BUG_SOURCE=playwright
# Clicks per journey. Also the target-site abuse control (SPECS.md §9). Set 0 to load pages
# without interacting at all, which is the conservative mode for a sensitive target.
MAX_STEPS_PER_JOURNEY=12

# ── Experiment sizing ── docs/DECISIONS.md 004: 12 x 5 = 60 judgments over 20 findings.
R1_PARTICIPANTS=12
R1_FINDINGS_PER_PARTICIPANT=5
R1_RATERS_PER_FINDING=3
R2_PARTICIPANTS=35
